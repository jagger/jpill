<?xml version="1.0" encoding="utf-8"?>
<!-- A flat capsule, solid on the left and empty on the right: a pill that doubles as a progress bar. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- the empty side and the outline of the whole capsule -->
    <path
        android:fillColor="#F6FAFE"
        android:strokeColor="#10202E"
        android:strokeWidth="2.5"
        android:pathData="M36,39 H72 A15,15 0 0 1 72,69 H36 A15,15 0 0 1 36,39 Z" />
    <!-- the solid side, flush with the outline, ending in a flat edge like a capsule's seam -->
    <path
        android:fillColor="#10202E"
        android:pathData="M36,39 H58 V69 H36 A15,15 0 0 1 36,39 Z" />
    <!-- gloss -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35"
        android:pathData="M33,44 H52 A1.3,1.3 0 0 1 52,46.6 H33 A1.3,1.3 0 0 1 33,44 Z" />
</vector>
